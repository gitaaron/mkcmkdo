[Unit]
Description=SportCam head-unit service
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sportcam/with_uwb/device
ExecStart=/usr/bin/python3 -m sportcam.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
