{
  "name": "sportcam",
  "private": true,
  "version": "0.1.0",
  "description": "Subject-tracking robotic camera tripod — Firebase backend + phone app",
  "workspaces": [
    "src/backend",
    "src/backend/functions"
  ],
  "scripts": {
    "dev": "npm run dev -w @sportcam/backend",
    "dev:with_uwb": "TRACKING_MODE=with_uwb npm run dev",
    "dev:without_uwb": "TRACKING_MODE=without_uwb npm run dev",
    "docs": "node tools/docs-server.mjs",
    "build": "npm run build -w @sportcam/backend",
    "test": "npm test -w @sportcam/backend",
    "check": "tools/claude-check.sh all",
    "typecheck": "npm run typecheck -w @sportcam/functions",
    "deploy": "./scripts/firebase-deploy.sh",
    "cad:fit": "python3 cad/fit.py",
    "cad:check": "python3 cad/fit.py --check",
    "cad:watch": "python3 cad/fit.py --watch",
    "hooks:install": "git config core.hooksPath \"$(git rev-parse --show-prefix)tools/hooks\""
  }
}
