{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", "src", "*.test.*", ".git"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "public",
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "storage": { "host": "0.0.0.0", "port": 9199 },
    "ui": { "enabled": true, "host": "0.0.0.0", "port": 4000 },
    "singleProjectMode": true
  }
}
