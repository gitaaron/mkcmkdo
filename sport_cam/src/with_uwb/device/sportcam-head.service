[Unit]
Description=SportCam head-unit service
# Not network-online.target: the camera has to be up, with its ring showing
# "connecting" or "pairing", while it has no network. sportcam-wifi says
# which (/run/sportcam-wifi.json).
After=sportcam-wifi.service pigpiod.service
Wants=sportcam-wifi.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sportcam/src/with_uwb/device
ExecStart=/usr/bin/python3 -m sportcam.main
Restart=always
RestartSec=3
# The power switch going off stops this service first: it saves the recording
# and parks (Head.power_off), then the Pi halts and the power latch lets go.
# Bounded, so a hung stop can't keep the camera on.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
