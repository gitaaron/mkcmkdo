[Unit]
Description=SportCam Wi-Fi: saved networks, else pairing (hotspot, setup page, QR join)
After=NetworkManager.service
Wants=NetworkManager.service
Before=sportcam-head.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/sportcam/src/without_uwb/device
ExecStart=/usr/bin/python3 -m sportcam.wifi_portal
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
