[Unit]
Description=SportCam head-unit service
# Not network-online.target: the camera has to be up, with its ring showing
# "connecting" or "pairing", while it has no network. sportcam-wifi says
# which (/run/sportcam-wifi.json).
After=sportcam-wifi.service
Wants=sportcam-wifi.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sportcam/src/without_uwb/device
ExecStart=/usr/bin/python3 -m sportcam.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
