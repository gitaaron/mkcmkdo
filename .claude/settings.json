{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; for s in \"$d/sport_cam/tools/claude-check.sh\" \"$d/tools/claude-check.sh\"; do [ -x \"$s\" ] && exec \"$s\"; done; exit 0",
            "timeout": 900,
            "statusMessage": "Running SportCam checks\u2026"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -x \"$d/sbx_setup.sh\" ] && exec \"$d/sbx_setup.sh\"; exit 0",
            "timeout": 900,
            "statusMessage": "Checking the sandbox's tools\u2026"
          }
        ]
      }
    ]
  }
}
